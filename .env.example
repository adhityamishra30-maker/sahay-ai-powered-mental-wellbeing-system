# Server-only secrets. Never expose these in client-side code.

# --- Required in production ------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of messages, names, contacts and
# locations in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it makes previously stored records unreadable.
DATA_ENCRYPTION_KEY=

# --- Staff passwords -------------------------------------------------------
# Initial / rotated passwords for the seeded staff accounts. If unset in
# production, a random password is generated and printed once in the server log.
# Changing a value and restarting updates that account's password.
SEED_PASSWORD_RIYA=
SEED_PASSWORD_DIVYA=
SEED_PASSWORD_AYUSH=
SEED_PASSWORD_PRASHANT=
SEED_PASSWORD_DISTRICT_OFFICER=
SEED_PASSWORD_STATE_OFFICER=
SEED_PASSWORD_NATIONAL_OFFICER=

# --- AI provider -----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Used only when GEMINI_API_KEY is empty:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional --------------------------------------------------------------
# Where sahay.db is stored (defaults to ./data, or RAILWAY_VOLUME_MOUNT_PATH on Railway).
DATA_DIR=
# Days before check-ins/alerts and audit entries are deleted automatically.
# If you change these, update the numbers shown on the Privacy page too.
RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
# Set to false ONLY if serving over plain HTTP on a private network.
COOKIE_SECURE=
